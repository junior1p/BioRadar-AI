# BioTender 自动化发布系统配置 v2.0
# 使用 GPTsAPI 中转站（文本生成）

# ==========================================
# API 配置
# ==========================================

# API 密钥
# 从 https://api.gptsapi.net 获取
# 注意: 不要将以下内容提交到git，使用 .env.local 本地配置
API_KEY=your-api-key-here

# API Base URL
# 默认: https://api.gptsapi.net (中转站)
# 也可改回: https://api.openai.com (官方OpenAI)
API_BASE_URL=https://api.gptsapi.net

# ==========================================
# 模型配置
# ==========================================

# 文本生成模型
# gpt-4.1-mini: 推荐（性价比高）
# gpt-4.1: 更强
# gpt-4-turbo: OpenAI官方
TEXT_MODEL=gpt-4.1-mini

# ==========================================
# 系统配置
# ==========================================

# 是否启用自动 Git Push
# true: 生成文章后自动push到仓库
# false: 仅本地生成文件，不自动push
GIT_PUSH=false

# 输出目录
OUTPUT_DIR=./content/posts

# API 调用超时时间（毫秒）
API_TIMEOUT=30000
